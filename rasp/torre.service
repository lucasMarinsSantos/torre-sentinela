[Unit]
Description=Torre Sentinela - servidor
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/torre-sentinela/rasp
ExecStart=/home/pi/torre-sentinela/rasp/venv/bin/python servidor.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
